@page
@model Web.Pages.Login.RegistroModel
@{
    Layout = null;
    ViewData["Title"] = "Crear Cuenta - Librería El Saber";
}
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- <script src="https://tailwindcss.com"></script>-->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- <link rel="preconnect" href="https://googleapis.com">-->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <!-- <link rel="preconnect" href="https://gstatic.com" crossorigin> -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- <link href="https://googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"> -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #060d1f;
            background-image: 
                radial-gradient(at 0% 0%, rgba(37, 99, 235, 0.25) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.20) 0px, transparent 50%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(59, 130, 246, 0.22);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.65);
        }
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
            20%, 40%, 60%, 80% { transform: translateX(4px); }
        }
        .animate-shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
        .floating-input:placeholder-shown ~ .floating-label {
            top: 50%; transform: translateY(-50%); font-size: 0.875rem; color: #94a3b8;
        }
        .floating-input:focus ~ .floating-label,
        .floating-input:not(:placeholder-shown) ~ .floating-label {
            top: -0.65rem; left: 0.75rem; font-size: 0.75rem; color: #60a5fa;
            background-color: #0b142b; padding: 0 0.35rem; border-radius: 0.25rem;
        }
        .bg-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(59, 130, 246, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(59, 130, 246, 0.05) 1px, transparent 1px);
        }
    </style>
</head>
<body class="bg-grid text-slate-200 flex items-center justify-center p-4 selection:bg-blue-500/30 selection:text-blue-200">
    <main class="relative z-10 w-full max-w-md">
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-sky-400 shadow-lg shadow-blue-500/30 mb-3">
                <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-white">Crear Cuenta</h1>
            <p class="text-sm text-blue-200/75 mt-1">Registro de usuario · Librería "El Saber"</p>
        </div>

        <div id="registroCard" class="glass-card rounded-2xl p-8 @(string.IsNullOrEmpty(Model.MensajeError) ? "" : "animate-shake")">
            <div id="errorMessage" class="@(string.IsNullOrEmpty(Model.MensajeError) ? "hidden" : "") mb-5 p-3.5 rounded-xl bg-red-500/15 border border-red-500/30 flex items-start gap-3 text-red-300 text-sm">
                <span id="errorText">@Model.MensajeError</span>
            </div>

            <form id="registroForm" method="post" class="space-y-5" novalidate>
                @Html.AntiForgeryToken()

                <div class="relative">
                    <input type="text" id="nombreCompletoInput" asp-for="RegistroInput.NombreCompleto" placeholder=" " required
                           class="floating-input peer w-full px-4 py-3.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-white placeholder-transparent focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25 transition-all text-sm" />
                    <label for="nombreCompletoInput" class="floating-label pointer-events-none absolute left-4 transition-all duration-200">Nombre completo</label>
                </div>

                <div class="relative">
                    <input type="text" id="usernameInput" asp-for="RegistroInput.NombreUsuario" placeholder=" " required autocomplete="username"
                           class="floating-input peer w-full px-4 py-3.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-white placeholder-transparent focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25 transition-all text-sm" />
                    <label for="usernameInput" class="floating-label pointer-events-none absolute left-4 transition-all duration-200">Nombre de usuario</label>
                </div>

                <div class="relative">
                    <input type="password" id="passwordInput" asp-for="RegistroInput.Password" placeholder=" " required autocomplete="new-password"
                           class="floating-input peer w-full px-4 py-3.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-white placeholder-transparent focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25 transition-all text-sm" />
                    <label for="passwordInput" class="floating-label pointer-events-none absolute left-4 transition-all duration-200">Contraseña (mín. 4 caracteres)</label>
                </div>

                <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold text-sm shadow-lg shadow-blue-600/30 transition-all cursor-pointer">
                    Registrarme
                </button>
            </form>

            <div class="mt-6 pt-5 border-t border-slate-700/60 text-center">
                <p class="text-xs text-slate-400">
                    ¿Ya tienes una cuenta? <a asp-page="/Login/Index" class="text-blue-400 hover:text-blue-300 font-semibold underline">Inicia sesión aquí</a>
                </p>
            </div>
        </div>
    </main>
</body>
</html>
