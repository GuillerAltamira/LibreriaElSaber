@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var nombreCompleto = HttpContextAccessor.HttpContext?.Session.GetString("NombreCompleto");
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("Rol");
    // La protección (login y roles) se hace en Program.cs, antes de llegar a la página
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Librería El Saber</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <!--
    <style>
        .navbar-azul {
            background: linear-gradient(90deg, #0f172a 0%, #1d4ed8 60%, #2563eb 100%);
        }
        .footer-azul {
            background-color: #0f172a;
            color: #cbd5e1;
        }
    </style> 
    -->
    <style>
        .navbar-azul {
            background: linear-gradient(90deg, #060d1f 0%, #1e3a8a 55%, #1d4ed8 100%);
            border-bottom: 1px solid rgba(96, 165, 250, 0.25);
        }
        .fondo-libreria {
            background-image: 
                linear-gradient(135deg, rgba(6, 13, 31, 0.88) 0%, rgba(15, 23, 42, 0.84) 50%, rgba(29, 78, 216, 0.78) 100%),
                url('/images/fondo-libreria.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }
        .footer-azul {
            background-color: rgba(6, 13, 31, 0.92);
            border-top: 1px solid rgba(96, 165, 250, 0.2);
            color: #cbd5e1;
        }
    </style>
</head>

<!-- <body class="d-flex flex-column min-vh-100 bg-light"> -->
<body class="d-flex flex-column min-vh-100 fondo-libreria">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-azul shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span>📚 Librería "El Saber"</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Categorias/Index">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Productos/Index">Productos</a>
                        </li>
                        @if (rol == "Administrador")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="ventasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Ventas
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="ventasDropdown">
                                    <li><a class="dropdown-item" asp-page="/Ventas/Registrar">Nueva Venta</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventas/Historial">Historial de Ventas</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Proveedores/Index">Proveedores</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Compras/Index">Compras</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-area="" asp-page="/Usuarios/Index">Usuarios</a>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(nombreCompleto))
                    {
                        <div class="d-flex align-items-center gap-3 text-white mt-2 mt-sm-0">
                            <span class="small">
                                👤 <strong>@nombreCompleto</strong>
                                <span class="badge @(rol == "Administrador" ? "bg-warning text-dark" : "bg-info text-dark") ms-1">@rol</span>
                            </span>
                            <a asp-page="/Login/Index" asp-page-handler="Logout" class="btn btn-outline-light btn-sm fw-semibold">
                                Cerrar sesión
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-azul py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 - Librería y Papelería "El Saber" &middot; Sistema de Gestión
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
