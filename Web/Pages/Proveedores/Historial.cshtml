@page "{id:guid}"
@model Web.Pages.Proveedores.HistorialModel
@{
    ViewData["Title"] = "Historial de compras - Librería El Saber";
    var prov = Model.Proveedor!;
}

<!-- Íconos de Bootstrap -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- Al imprimir: oculta el menú, el pie y los botones, y abre todas las facturas -->
<style>
    @@media print {
        header, footer, .no-print {
            display: none !important;
        }

        .collapse {
            display: block !important;
        }

        .banner {
            color: black !important;
            background: none !important;
            box-shadow: none !important;
            border: 1px solid #ccc;
        }
    }
</style>

<!-- ===== BANNER CON LOS DATOS DEL PROVEEDOR ===== -->
<div class="banner mb-4">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="avatar-grande">@(string.IsNullOrEmpty(prov.Nombre) ? "?" : prov.Nombre.Substring(0, 1).ToUpper())</div>
        <div class="flex-grow-1">
            <div class="small opacity-75"><i class="bi bi-clock-history me-1"></i>Historial de compras</div>
            <h3 class="mb-1 fw-bold">
                @prov.Nombre
                @if (prov.Activo)
                {
                    <span class="badge rounded-pill bg-success fs-6 align-middle">Activo</span>
                }
                else
                {
                    <span class="badge rounded-pill bg-secondary fs-6 align-middle">Inactivo</span>
                }
            </h3>
            <div class="small d-flex flex-wrap gap-3 opacity-75">
                <span><i class="bi bi-card-text me-1"></i>NIT @prov.Nit</span>
                @if (!string.IsNullOrEmpty(prov.Telefono))
                {
                    <span><i class="bi bi-telephone me-1"></i>@prov.Telefono</span>
                }
                @if (!string.IsNullOrEmpty(prov.Correo))
                {
                    <span><i class="bi bi-envelope me-1"></i>@prov.Correo</span>
                }
                @if (!string.IsNullOrEmpty(prov.Direccion))
                {
                    <span><i class="bi bi-geo-alt me-1"></i>@prov.Direccion</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 no-print">
            <button type="button" class="btn btn-outline-light" onclick="window.print()"><i class="bi bi-printer me-1"></i>Imprimir / PDF</button>
            <a asp-page="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>
    </div>
</div>

<!-- ===== TARJETAS DE RESUMEN ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat stat-azul">
            <div class="stat-titulo">Compras</div>
            <div class="stat-numero">@Model.Compras.Count</div>
            <div class="stat-pie">Última: @(Model.UltimaCompra?.ToString("dd/MM/yyyy") ?? "—")</div>
            <i class="bi bi-receipt stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-morado">
            <div class="stat-titulo">Total comprado</div>
            <div class="stat-numero">Bs @Model.TotalGeneral.ToString("N2")</div>
            <div class="stat-pie">Promedio: Bs @Model.PromedioPorCompra.ToString("N2")</div>
            <i class="bi bi-cash-stack stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-verde">
            <div class="stat-titulo">Unidades compradas</div>
            <div class="stat-numero">@Model.TotalProductos</div>
            <div class="stat-pie">En todas las facturas</div>
            <i class="bi bi-box-seam stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-naranja">
            <div class="stat-titulo">Producto más comprado</div>
            <div class="stat-numero stat-texto">@(Model.ProductoTop ?? "—")</div>
            <div class="stat-pie">Por cantidad</div>
            <i class="bi bi-star-fill stat-icono"></i>
        </div>
    </div>
</div>

@if (Model.Compras.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Este proveedor todavía no tiene compras registradas.
        </div>
    </div>
}
else
{
    <!-- ===== GRÁFICO POR MES ===== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold"><i class="bi bi-graph-up-arrow text-primary me-1"></i> Compras por mes (Bs)</div>
        <div class="card-body">
            <canvas id="graficoMeses" height="90"></canvas>
        </div>
    </div>

    <!-- ===== FACTURAS ===== -->
    <h5 class="fw-semibold mb-3 text-white"><i class="bi bi-receipt-cutoff me-1"></i> Detalle de facturas</h5>
    <div class="accordion shadow-sm" id="acordeonCompras">
        @for (var i = 0; i < Model.Compras.Count; i++)
        {
            var compra = Model.Compras[i];
            var idPanel = $"compra{i}";
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button"
                            data-bs-toggle="collapse" data-bs-target="#@idPanel">
                        <div class="d-flex flex-wrap w-100 justify-content-between me-3 gap-2">
                            <span><i class="bi bi-receipt me-1 text-primary"></i><strong>Factura @compra.NumeroFactura</strong></span>
                            <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>@compra.Fecha.ToString("dd/MM/yyyy")</span>
                            <span class="text-muted"><i class="bi bi-box me-1"></i>@compra.Detalles.Count producto(s)</span>
                            <span class="badge monto fs-6">Bs @compra.Total.ToString("N2")</span>
                        </div>
                    </button>
                </h2>
                <div id="@idPanel" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#acordeonCompras">
                    <div class="accordion-body p-0">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="cabecera">
                                <tr>
                                    <th class="ps-3">Producto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Costo unitario</th>
                                    <th class="text-end pe-3">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in compra.Detalles)
                                {
                                    <tr>
                                        <td class="ps-3">@d.Producto</td>
                                        <td class="text-center">@d.Cantidad</td>
                                        <td class="text-end">Bs @d.CostoUnitario.ToString("N2")</td>
                                        <td class="text-end pe-3">Bs @d.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td class="ps-3" colspan="3">Total de la factura</td>
                                    <td class="text-end pe-3">Bs @compra.Total.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    @if (Model.Compras.Count > 0)
    {
        <!-- Chart.js para el gráfico -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            const Grafico = window['Chart'];
            new Grafico(document.getElementById('graficoMeses'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Model.MesesJson),
                    datasets: [{
                        label: 'Total comprado (Bs)',
                        data: @Html.Raw(Model.TotalesPorMesJson),
                        backgroundColor: 'rgba(111, 66, 193, 0.7)',
                        borderRadius: 8
                    }]
                },
                options: { plugins: { legend: { display: false } } }
            });
        </script>
    }
}