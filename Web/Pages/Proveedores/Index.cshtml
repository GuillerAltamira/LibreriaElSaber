@page
@model Web.Pages.Proveedores.IndexModel
@{
    ViewData["Title"] = "Proveedores - Librería El Saber";
}

<!-- Íconos de Bootstrap -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- ===== BANNER ===== -->
<div class="banner mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="mb-1 fw-bold"><i class="bi bi-truck me-2"></i>Proveedores</h2>
            <p class="mb-0 opacity-75">Registra, actualiza y consulta el historial de compras de tus proveedores</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Index" asp-page-handler="Exportar" asp-all-route-data="Model.Ruta()" class="btn btn-outline-light">
                <i class="bi bi-file-earmark-excel me-1"></i> Exportar a Excel
            </a>
            <button type="button" class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#modalNuevo">
                <i class="bi bi-plus-lg me-1"></i> Nuevo proveedor
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @(Model.EsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== TARJETAS DE RESUMEN ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat stat-azul">
            <div class="stat-titulo">Total proveedores</div>
            <div class="stat-numero">@Model.Todos.Count</div>
            <div class="stat-pie"><i class="bi bi-plus-circle me-1"></i>@Model.NuevosEsteMes nuevo(s) este mes</div>
            <i class="bi bi-people-fill stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-verde">
            <div class="stat-titulo">Activos</div>
            <div class="stat-numero">@Model.TotalActivos</div>
            <div class="stat-pie">Disponibles para comprar</div>
            <i class="bi bi-check-circle-fill stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-naranja">
            <div class="stat-titulo">Inactivos</div>
            <div class="stat-numero">@Model.TotalInactivos</div>
            <div class="stat-pie">Pausados temporalmente</div>
            <i class="bi bi-pause-circle-fill stat-icono"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-morado">
            <div class="stat-titulo">Total comprado</div>
            <div class="stat-numero">Bs @Model.TotalComprado.ToString("N2")</div>
            <div class="stat-pie">A todos los proveedores</div>
            <i class="bi bi-cash-stack stat-icono"></i>
        </div>
    </div>
</div>

<!-- ===== GRÁFICOS ===== -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-trophy text-warning me-1"></i> Top 5 proveedores por monto comprado</div>
            <div class="card-body">
                @if (Model.Top5.Count == 0)
                {
                    <div class="text-center text-muted py-4"><i class="bi bi-bar-chart fs-1 d-block mb-2"></i>Aún no hay compras registradas.</div>
                }
                else
                {
                    <canvas id="graficoTop" height="140"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-pie-chart text-primary me-1"></i> Estado de proveedores</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (Model.Todos.Count == 0)
                {
                    <div class="text-center text-muted py-4">Sin datos</div>
                }
                else
                {
                    <canvas id="graficoEstado" height="200"></canvas>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== BUSCADOR Y FILTRO ===== -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="orden" value="@Model.Orden" />
            <input type="hidden" name="dir" value="@Model.Dir" />
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                    <input asp-for="Buscar" class="form-control" placeholder="Buscar por nombre o NIT..." />
                </div>
            </div>
            <div class="col-md-3">
                <select asp-for="Estado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="activos">Solo activos</option>
                    <option value="inactivos">Solo inactivos</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-page="Index" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- ===== TABLA ===== -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-list-ul me-1"></i> Listado de proveedores</span>
        <span class="badge rounded-pill text-bg-primary">@Model.Filtrados.Count resultado(s)</span>
    </div>

    @if (Model.Proveedores.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            @(Model.Todos.Count == 0 ? "No hay proveedores registrados aún." : "Ningún proveedor coincide con la búsqueda.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="cabecera">
                    <tr>
                        <th><a asp-page="Index" asp-all-route-data='Model.Ruta(orden: "nombre")'>Proveedor <i class="bi @Model.IconoOrden("nombre")"></i></a></th>
                        <th><a asp-page="Index" asp-all-route-data='Model.Ruta(orden: "nit")'>NIT <i class="bi @Model.IconoOrden("nit")"></i></a></th>
                        <th>Contacto</th>
                        <th class="text-center"><a asp-page="Index" asp-all-route-data='Model.Ruta(orden: "compras")'>Compras <i class="bi @Model.IconoOrden("compras")"></i></a></th>
                        <th class="text-end"><a asp-page="Index" asp-all-route-data='Model.Ruta(orden: "total")'>Total comprado <i class="bi @Model.IconoOrden("total")"></i></a></th>
                        <th><a asp-page="Index" asp-all-route-data='Model.Ruta(orden: "estado")'>Estado <i class="bi @Model.IconoOrden("estado")"></i></a></th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prov in Model.Proveedores)
                    {
                        <tr class="@(prov.Activo ? "" : "fila-inactiva")">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar @Model.ColorAvatar(prov.Nombre) me-2">@(string.IsNullOrEmpty(prov.Nombre) ? "?" : prov.Nombre.Substring(0, 1).ToUpper())</div>
                                    <div>
                                        <div class="fw-semibold">@prov.Nombre</div>
                                        <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@(prov.Direccion ?? "Sin dirección")</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">@prov.Nit</span></td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(prov.Telefono))
                                {
                                    <div><i class="bi bi-telephone text-success me-1"></i>@prov.Telefono</div>
                                }
                                @if (!string.IsNullOrEmpty(prov.Correo))
                                {
                                    <div><i class="bi bi-envelope text-primary me-1"></i>@prov.Correo</div>
                                }
                                @if (string.IsNullOrEmpty(prov.Telefono) && string.IsNullOrEmpty(prov.Correo))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @(Model.ComprasDe(prov.Id) > 0 ? "text-bg-info" : "text-bg-light border")">@Model.ComprasDe(prov.Id)</span>
                            </td>
                            <td class="text-end fw-semibold">Bs @Model.TotalDe(prov.Id).ToString("N2")</td>
                            <td>
                                @if (prov.Activo)
                                {
                                    <span class="badge rounded-pill text-bg-success"><i class="bi bi-circle-fill me-1 punto"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary"><i class="bi bi-circle-fill me-1 punto"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-page="Index" asp-all-route-data="Model.Ruta(editarId: prov.Id)" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-page="Historial" asp-route-id="@prov.Id" class="btn btn-sm btn-outline-info" title="Historial de compras">
                                    <i class="bi bi-clock-history"></i>
                                </a>
                                <form method="post" asp-page-handler="CambiarEstado" asp-all-route-data="Model.Ruta()" class="d-inline"
                                      data-mensaje="¿Seguro que quieres @(prov.Activo ? "desactivar" : "activar") a @prov.Nombre?"
                                      onsubmit="return confirm(this.dataset.mensaje)">
                                    <input type="hidden" name="id" value="@prov.Id" />
                                    @if (prov.Activo)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar"><i class="bi bi-toggle-on"></i></button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Activar"><i class="bi bi-toggle-off"></i></button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="small text-muted">Página @Model.Pagina de @Model.TotalPaginas</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                            <a asp-page="Index" class="page-link" asp-all-route-data="Model.Ruta(pagina: Model.Pagina - 1)"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                <a asp-page="Index" class="page-link" asp-all-route-data="Model.Ruta(pagina: i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                            <a asp-page="Index" class="page-link" asp-all-route-data="Model.Ruta(pagina: Model.Pagina + 1)"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- ===== MODAL NUEVO ===== -->
<div class="modal fade" id="modalNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear" asp-all-route-data="Model.Ruta()">
                <div class="modal-header modal-header-color text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo proveedor</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input asp-for="NuevoProveedor.Nombre" class="form-control" placeholder="Ej: Distribuidora Andina" required />
                        <span asp-validation-for="NuevoProveedor.Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">NIT *</label>
                        <input asp-for="NuevoProveedor.Nit" class="form-control" placeholder="Solo números" required />
                        <span asp-validation-for="NuevoProveedor.Nit" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono</label>
                            <input asp-for="NuevoProveedor.Telefono" class="form-control" placeholder="Ej: 72345678" />
                            <span asp-validation-for="NuevoProveedor.Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Correo</label>
                            <input asp-for="NuevoProveedor.Correo" type="email" class="form-control" placeholder="correo@empresa.com" />
                            <span asp-validation-for="NuevoProveedor.Correo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input asp-for="NuevoProveedor.Direccion" class="form-control" />
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="NuevoProveedor.Activo" class="form-check-input" />
                        <label asp-for="NuevoProveedor.Activo" class="form-check-label">Proveedor activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== MODAL EDITAR ===== -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Editar" asp-all-route-data="Model.Ruta()">
                <input type="hidden" asp-for="IdEditar" />
                <div class="modal-header modal-header-color text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar proveedor</h5>
                    <a asp-page="Index" asp-all-route-data="Model.Ruta()" class="btn-close btn-close-white"></a>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input asp-for="ProveedorEditado.Nombre" class="form-control" required />
                        <span asp-validation-for="ProveedorEditado.Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">NIT *</label>
                        <input asp-for="ProveedorEditado.Nit" class="form-control" required />
                        <span asp-validation-for="ProveedorEditado.Nit" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono</label>
                            <input asp-for="ProveedorEditado.Telefono" class="form-control" />
                            <span asp-validation-for="ProveedorEditado.Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Correo</label>
                            <input asp-for="ProveedorEditado.Correo" type="email" class="form-control" />
                            <span asp-validation-for="ProveedorEditado.Correo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input asp-for="ProveedorEditado.Direccion" class="form-control" />
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="ProveedorEditado.Activo" class="form-check-input" />
                        <label asp-for="ProveedorEditado.Activo" class="form-check-label">Proveedor activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <a asp-page="Index" asp-all-route-data="Model.Ruta()" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js para los gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const Grafico = window['Chart'];

        // Gráfico de barras: Top 5 proveedores
        const lienzoTop = document.getElementById('graficoTop');
        if (lienzoTop) {
            new Grafico(lienzoTop, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Model.Top5NombresJson),
                    datasets: [{
                        label: 'Total comprado (Bs)',
                        data: @Html.Raw(Model.Top5TotalesJson),
                        backgroundColor: ['#0d6efd', '#6f42c1', '#20c997', '#fd7e14', '#d63384'],
                        borderRadius: 8
                    }]
                },
                options: { indexAxis: 'y', plugins: { legend: { display: false } } }
            });
        }

        // Gráfico de dona: activos vs inactivos
        const lienzoEstado = document.getElementById('graficoEstado');
        if (lienzoEstado) {
            new Grafico(lienzoEstado, {
                type: 'doughnut',
                data: {
                    labels: ['Activos', 'Inactivos'],
                    datasets: [{
                        data: [@Model.TotalActivos, @Model.TotalInactivos],
                        backgroundColor: ['#198754', '#fd7e14']
                    }]
                },
                options: { plugins: { legend: { position: 'bottom' } }, cutout: '65%' }
            });
        }
    </script>

    @if (Model.ModalAbierto != null)
    {
        <!-- Abre el modal que toca (por error o por clic en Editar) -->
        <script>
            window['bootstrap'].Modal.getOrCreateInstance(
                document.getElementById('@(Model.ModalAbierto == "editar" ? "modalEditar" : "modalNuevo")')
            ).show();
        </script>
    }
}