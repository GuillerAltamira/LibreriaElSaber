@page
@model Web.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-0">👥 Gestión de Usuarios</h2>
        <p class="text-muted small mb-0">Administración de cuentas y roles del sistema</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var esError = Model.Mensaje.StartsWith("Error");
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
        @Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Formulario Nuevo Usuario -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white fw-semibold rounded-top-4 py-3">
                + Registrar Nuevo Usuario
            </div>
            <div class="card-body p-4">
                <form method="post" asp-page-handler="Crear">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre Completo</label>
                        <input type="text" asp-for="NuevoUsuario.NombreCompleto" class="form-control" placeholder="Ej. Juan Pérez" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre de Usuario</label>
                        <input type="text" asp-for="NuevoUsuario.NombreUsuario" class="form-control" placeholder="Ej. jperez" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Contraseña</label>
                        <input type="password" asp-for="NuevoUsuario.Password" class="form-control" placeholder="Mínimo 4 caracteres" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Rol de Acceso</label>
                        <select asp-for="NuevoUsuario.Rol" class="form-select">
                            <option value="Usuario">Usuario (Solo Productos y Categorías)</option>
                            <option value="Administrador">Administrador (Acceso Total)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        Guardar Usuario
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white fw-semibold py-3 border-bottom">
                Usuarios Registrados (@Model.ListaUsuarios.Count)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Nombre Completo</th>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.ListaUsuarios)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium">@u.NombreCompleto</td>
                                    <td><span class="text-muted">@@</span>@u.NombreUsuario</td>
                                    <td>
                                        @if (u.Rol == "Administrador")
                                        {
                                            <span class="badge bg-primary">Administrador</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Usuario</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (u.NombreUsuario.ToLower() != "admin")
                                        {
                                            <form method="post" asp-page-handler="Eliminar" asp-route-id="@u.Id" class="d-inline"
                                                  onsubmit="return confirm('¿Seguro que deseas eliminar al usuario @u.NombreUsuario?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Protegido</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
