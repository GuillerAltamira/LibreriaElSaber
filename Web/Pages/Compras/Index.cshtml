@page
@model Web.Pages.Compras.IndexModel
@{
    ViewData["Title"] = "Gestión de Compras";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-white fw-bold">Gestión de Compras e Inventario</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaCompra">
            + Registrar Nueva Compra
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Resumen de Control de Costos -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <h6 class="text-muted">Total Invertido en Compras</h6>
                    <h3 class="text-primary">Bs @Model.TotalInvertido.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="text-muted">Unidades Ingresadas al Stock</h6>
                    <h3 class="text-success">+@Model.TotalUnidadesIngresadas unid.</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body">
                    <h6 class="text-muted">Facturas Registradas</h6>
                    <h3>@Model.Compras.Count</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Historial de Compras -->
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>N° Factura</th>
                    <th>Proveedor</th>
                    <th>Unidades</th>
                    <th>Total Compra</th>
                    <th>Control de Costos / Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var compra in Model.Compras)
                {
                    <tr>
                        <td>@compra.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong>@compra.NumeroFactura</strong></td>
                        <td>@compra.NombreProveedor</td>
                        <td><span class="badge bg-success">+@compra.CantidadItems</span></td>
                        <td><strong>Bs @compra.Total.ToString("N2")</strong></td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-info"
                                    data-bs-toggle="modal" data-bs-target="#detalle-@compra.Id">
                                Ver Costos y Productos
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modales de Detalle y Control de Costos -->
@foreach (var compra in Model.Compras)
{
    <div class="modal fade" id="detalle-@compra.Id" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle Factura @compra.NumeroFactura - @compra.NombreProveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Cant.</th>
                                <th>Costo Compra</th>
                                <th>Precio Venta</th>
                                <th>Margen Unit.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var det in compra.Detalles)
                            {
                                <tr>
                                    <td>@det.NombreProducto</td>
                                    <td>@det.Cantidad</td>
                                    <td>Bs @det.CostoUnitario.ToString("N2")</td>
                                    <td>Bs @det.PrecioVentaActual.ToString("N2")</td>
                                    <td class="@(det.MargenGanancia > 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                        Bs @det.MargenGanancia.ToString("N2")
                                    </td>
                                    <td>Bs @det.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Registrar Nueva Compra -->
<div class="modal fade" id="modalNuevaCompra" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Compra e Ingreso de Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Proveedor</label>
                            <select asp-for="NuevaCompra.ProveedorId" asp-items="Model.OpcionesProveedores" class="form-select" required>
                                <option value="">-- Seleccione Proveedor --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Número de Factura</label>
                            <input value="@Model.SiguienteNumero" class="form-control bg-light fw-semibold" readonly />
                            <small class="text-muted">Se genera automáticamente al guardar.</small>
                        </div>
                    </div>

                    <h6>Productos a Ingresar</h6>
                    <table class="table table-bordered" id="tablaDetalles">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width: 120px;">Cantidad</th>
                                <th style="width: 150px;">Costo Unit.</th>
                                <th style="width: 130px;">Subtotal</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoDetalles">
                            <tr>
                                <td>
                                    <select name="NuevaCompra.Detalles[0].ProductoId" class="form-select" required>
                                        <option value="">-- Producto --</option>
                                        @foreach (var p in Model.ListaProductos)
                                        {
                                            <option value="@p.Id">@p.Nombre (Venta: Bs @p.Precio.ToString("N2"))</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="NuevaCompra.Detalles[0].Cantidad" class="form-control cantidad" min="1" value="1" oninput="recalcular()" required />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="NuevaCompra.Detalles[0].CostoUnitario" class="form-control costo" min="0.01" value="0" oninput="recalcular()" required />
                                </td>
                                <td class="subtotal align-middle fw-bold">Bs 0.00</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="agregarFila()">+ Agregar Producto</button>
                        <h5>Total Compra: <span id="totalCompra">Bs 0.00</span></h5>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Compra y Sumar Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let indice = 1;
        const productosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListaProductos));

        function construirOpcionesProductos() {
            let html = '<option value="">-- Producto --</option>';
            for (const p of productosData) {
                const id = p.Id ?? p.id;
                const nombre = p.Nombre ?? p.nombre ?? '';
                const precio = Number(p.Precio ?? p.precio ?? 0).toFixed(2);
                html += `<option value="${id}">${nombre} (Venta: Bs ${precio})</option>`;
            }
            return html;
        }

        function agregarFila() {
            const tbody = document.getElementById("cuerpoDetalles");
            const fila = document.createElement("tr");
            fila.innerHTML = `
                        <td>
                            <select name="NuevaCompra.Detalles[${indice}].ProductoId" class="form-select" required>
                                ${construirOpcionesProductos()}
                            </select>
                        </td>
                        <td><input type="number" name="NuevaCompra.Detalles[${indice}].Cantidad" class="form-control cantidad" min="1" value="1" oninput="recalcular()" required /></td>
                        <td><input type="number" step="0.01" name="NuevaCompra.Detalles[${indice}].CostoUnitario" class="form-control costo" min="0.01" value="0" oninput="recalcular()" required /></td>
                        <td class="subtotal align-middle fw-bold">Bs 0.00</td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="eliminarFila(this)">X</button></td>
                    `;
            tbody.appendChild(fila);
            indice++;
        }

        function eliminarFila(btn) {
            btn.closest("tr").remove();
            renumerarFilas();
            recalcular();
        }

        // Vuelve a numerar las filas (0, 1, 2...) para que no queden huecos.
        // Si queda un hueco (0, 2), ASP.NET deja de leer y se pierden productos.
        function renumerarFilas() {
            const filas = document.querySelectorAll("#cuerpoDetalles tr");
            filas.forEach((tr, i) => {
                tr.querySelectorAll("[name^='NuevaCompra.Detalles[']").forEach(campo => {
                    campo.name = campo.name.replace(/Detalles\[\d+\]/, "Detalles[" + i + "]");
                });
            });
            indice = filas.length;
        }

        function recalcular() {
            let total = 0;
            document.querySelectorAll("#cuerpoDetalles tr").forEach(tr => {
                const cant = parseFloat(tr.querySelector(".cantidad")?.value) || 0;
                const costo = parseFloat(tr.querySelector(".costo")?.value) || 0;
                const sub = cant * costo;
                tr.querySelector(".subtotal").textContent = "Bs " + sub.toFixed(2);
                total += sub;
            });
            document.getElementById("totalCompra").textContent = "Bs " + total.toFixed(2);
        }

        @if (Model.AbrirModal)
            {
                <text>
                    document.addEventListener("DOMContentLoaded", function () {
                        new bootstrap.Modal(document.getElementById('modalNuevaCompra')).show();
                    });
            </text>
        }
    </script>
}