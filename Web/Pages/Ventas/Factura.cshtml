@page
@model Web.Pages.Ventas.FacturaModel
@{
    ViewData["Title"] = "Factura de Venta";
}

<div class="container py-4">
    <div class="d-print-none d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-page="/Ventas/Historial" class="btn btn-outline-secondary me-2">
                &larr; Volver al Historial
            </a>
            <a asp-page="/Ventas/Registrar" class="btn btn-outline-primary">
                + Nueva Venta
            </a>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-success">
                Imprimir Factura
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @Model.MensajeError
        </div>
    }
    else if (Model.Factura != null)
    {
        <div class="card shadow-sm border-1 mx-auto factura-container" style="max-width: 800px;">
            <div class="card-body p-4 p-md-5">
                <!-- Membrete -->
                <div class="row align-items-center mb-4 pb-3 border-bottom">
                    <div class="col-sm-7">
                        <h2 class="fw-bold text-primary mb-1">LIBRERÍA EL SABER</h2>
                        <p class="text-muted small mb-0">Sistema de Control de Ventas e Inventario</p>
                        <p class="text-muted small mb-0">Casa Matriz: Calle Comercio #123</p>
                        <p class="text-muted small mb-0">Tarija - Bolivia</p>
                    </div>
                    <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                        <div class="border rounded p-3 bg-light d-inline-block text-start">
                            <div class="fw-bold text-danger fs-5">@Model.Factura.NumeroFactura</div>
                            <div class="small"><strong>NIT Emisor:</strong> 1029384756</div>
                            <div class="small"><strong>Autorización:</strong> 49200192837</div>
                        </div>
                    </div>
                </div>

                <!-- Datos de la transacción -->
                <div class="row g-3 mb-4 p-3 bg-light rounded">
                    <div class="col-sm-6">
                        <div class="small text-muted">Fecha y Hora de Emisión:</div>
                        <div class="fw-bold">@Model.Factura.FechaEmision.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">NIT / CI del Cliente:</div>
                        <div class="fw-bold">@Model.Factura.Nit</div>
                    </div>
                    <div class="col-12">
                        <div class="small text-muted">Señor(es) / Razón Social:</div>
                        <div class="fw-bold fs-6">@Model.Factura.RazonSocial</div>
                    </div>
                </div>

                <!-- Detalle de la Factura -->
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th class="text-center" style="width: 10%;">Cant.</th>
                                <th style="width: 55%;">Descripción / Producto</th>
                                <th class="text-end" style="width: 15%;">P. Unit (Bs.)</th>
                                <th class="text-end" style="width: 20%;">Subtotal (Bs.)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Factura.Detalles)
                            {
                                <tr>
                                    <td class="text-center">@item.Cantidad</td>
                                    <td>@item.ProductoNombre</td>
                                    <td class="text-end">@item.PrecioUnitario.ToString("0.00")</td>
                                    <td class="text-end fw-semibold">@item.Subtotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5">TOTAL A PAGAR:</td>
                                <td class="text-end fw-bold fs-5 text-success">Bs. @Model.Factura.Total.ToString("0.00")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Pie Legal de la Factura -->
                <div class="text-center pt-3 border-top text-muted small">
                    <p class="mb-1 fw-semibold">"ESTA FACTURA CONTRIBUYE AL DESARROLLO DEL PAÍS, EL USO ILÍCITO SERÁ SANCIONADO PENALMENTE DE ACUERDO A LEY"</p>
                    <p class="mb-0">Ley N° 453: El proveedor deberá entregar la factura al usuario o consumidor final.</p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    @@media print {
        header, footer, .d-print-none, .navbar {
            display: none !important;
        }
        body {
            background-color: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
        .factura-container {
            border: none !important;
            box-shadow: none !important;
            width: 100% !important;
            max-width: 100% !important;
        }
    }
</style>
