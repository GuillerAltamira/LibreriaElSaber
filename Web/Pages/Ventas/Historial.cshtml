@page
@model Web.Pages.Ventas.HistorialModel
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Historial de Ventas</h2>
            <p class="text-muted mb-0">Listado general de ventas efectuadas y facturas emitidas.</p>
        </div>
        <div>
            <a asp-page="/Ventas/Registrar" class="btn btn-primary">
                + Nueva Venta
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @Model.MensajeError
        </div>
    }

    <!-- Tarjetas de métricas rápidas -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-3">
                    <div class="small text-white-50 text-uppercase fw-bold">Total Transacciones</div>
                    <div class="fs-3 fw-bold">@Model.Ventas.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body p-3">
                    <div class="small text-white-50 text-uppercase fw-bold">Monto Total Recaudado</div>
                    <div class="fs-3 fw-bold">Bs. @Model.TotalVendido.ToString("0.00")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-dark">
                <div class="card-body p-3">
                    <div class="small text-dark-50 text-uppercase fw-bold">Artículos Vendidos</div>
                    <div class="fs-3 fw-bold">@Model.TotalArticulosVendidos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Ventas -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>N° Factura</th>
                            <th>Cliente / Razón Social</th>
                            <th>NIT / CI</th>
                            <th class="text-center">Artículos</th>
                            <th class="text-end">Total (Bs.)</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Comprobante</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ventas.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    No se encontraron ventas registradas aún.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var venta in Model.Ventas)
                            {
                                <tr>
                                    <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-bold">
                                            @(venta.Factura?.NumeroFactura ?? "S/F")
                                        </span>
                                    </td>
                                    <td class="fw-semibold">
                                        @(venta.Factura?.RazonSocial ?? "Venta General")
                                    </td>
                                    <td>
                                        @(venta.Factura?.Nit ?? "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">
                                            @(venta.Detalles?.Sum(d => d.Cantidad) ?? 0)
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        Bs. @venta.Total.ToString("0.00")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success">
                                            @venta.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-page="/Ventas/Factura" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-primary" title="Ver Factura">
                                            Ver Factura
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
